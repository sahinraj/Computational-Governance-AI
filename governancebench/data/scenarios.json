      {"id": "LAW-OVERRIDE-001", "capability": "payment.send", "constraint": "amount <= 100", "requires_approval": "FinanceLead", "on_violation": "escalate"}
    ],
    "actors": [
      {"id": "finance_agent", "authority_level": 5, "class": "finance", "capabilities": ["payment.send"]}
    ],
    "trace": [
      {"step": 1, "actor": "finance_agent", "action": {"capability": "payment.send", "params": {"amount": 150}}, "context": {"budget_used": 0, "prior_approvals": [], "now": 0}, "expected": "Allow", "tests": "LAW-OVERRIDE-001", "human_decision": "Allow"}
    ]
  }
