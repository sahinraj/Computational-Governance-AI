    ],
    "actors": [
      {"id": "admin_agent", "authority_level": 5, "class": "engineer", "capabilities": ["github.write"]},
      {"id": "broker_agent", "authority_level": 3, "class": "service"},
      {"id": "contractor_agent", "authority_level": 3, "class": "contractor"}
    ],
    "setup": [
      {"delegate": {"id": "grant-broker", "from": "admin_agent", "to": "broker_agent", "capability": "github.write", "depth": 0}}
    ],
    "trace": [
      {"step": 1, "actor": "contractor_agent", "action": {"capability": "github.write", "params": {"repo": "core", "op": "push"}}, "context": {"budget_used": 0, "prior_approvals": [], "now": 0}, "expected": "Block", "tests": "LAW-MULTI-001"}
    ]
  },
  {
    "schema_version": "1.0",
    "id": "GB-0010",
    "category": "human_override",
    "description": "A human override converts an escalation into an allowed decision for the current action.",
